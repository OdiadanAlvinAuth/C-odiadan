Gym Membership
import { useState, useMemo, useCallback } from 'react';

export default function GymWebsite() {
  const [selectedPlan, setSelectedPlan] = useState('Basic');
  const [formData, setFormData] = useState({ name: '', email: '', phone: '' });

  const plans = useMemo(() => [
    { name: 'Basic', price: '$20/mo' },
    { name: 'Premium', price: '$35/mo' },
    { name: 'Pro', price: '$50/mo' }
  ], []);

  const handlePlanChange = useCallback((planName) => {
    setSelectedPlan(planName);
  }, []);

  const handleInputChange = useCallback((e) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
  }, []);

  const handleSubmit = useCallback((e) => {
    e.preventDefault();
    console.log('Signup submitted:', formData);
    alert(`Thanks for signing up, ${formData.name || 'Guest'}!`);
  }, [formData]);

  return (
    <div style={styles.app}>
      <header style={styles.header}>
        <h1 style={styles.logo}>🏋️ AUTHENTIC DAN GYM</h1>
        <p style={styles.tagline}>Achieve Your Fitness Goals with Us</p>
      </header>
      <section style={styles.section}>
        <h2 style={styles.sectionTitle}>💪 Our Classes</h2>
        <ul style={styles.list}>
          <li>HIIT Training</li>
          <li>Yoga & Meditation</li>
          <li>CrossFit</li>
          <li>Strength Training</li>
        </ul>
      </section>
      <section style={styles.section}>
        <h2 style={styles.sectionTitle}>👤 Personal Workout Programs</h2>
        <p>We provide 1-on-1 personal training, custom workout plans, and ongoing fitness assessments to tailor your journey.</p>
      </section>

      <section style={styles.section}>
        <h2 style={styles.sectionTitle}>💳 Membership Plans</h2>
        <div style={styles.planGrid}>
          {plans.map((plan) => (
            <div
              key={plan.name}
              role="button"
              tabIndex={0}
              onClick={() => handlePlanChange(plan.name)}
              onKeyDown={(e) => e.key === 'Enter' && handlePlanChange(plan.name)}
              style={{
                ...styles.planCard,
                ...(selectedPlan === plan.name ? styles.selectedCard : {})
              }}
            >
              <h3 style={styles.cardTitle}>{plan.name}</h3>
              <p style={styles.cardPrice}>{plan.price}</p>
            </div>
          ))}
        </div>
      </section>
      <section style={styles.section}>
        <h2 style={styles.sectionTitle}>📅 Weekly Schedule</h2>
        <table style={styles.table}>
          <thead>
            <tr>
              <th>Day</th>
              <th>Morning</th>
              <th>Evening</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Monday</td><td>Yoga</td><td>HIIT</td></tr>
            <tr><td>Tuesday</td><td>Strength</td><td>CrossFit</td></tr>
            <tr><td>Wednesday</td><td>Cardio</td><td>Boxing</td></tr>
            <tr><td>Thursday</td><td>Stretch</td><td>HIIT</td></tr>
            <tr><td>Friday</td><td>CrossFit</td><td>Strength</td></tr>
          </tbody>
        </table>
      </section>

      {/* Signup Form */}
      <section style={styles.section}>
        <h2 style={styles.sectionTitle}>📝 Sign Up</h2>
        <form style={styles.form} onSubmit={handleSubmit}>
          <input
            style={styles.input}
            type="text"
            name="name"
            placeholder="Full Name"
            value={formData.name}
            onChange={handleInputChange}
          />
          <input
            style={styles.input}
            type="email"
            name="email"
            placeholder="Email"
            value={formData.email}
            onChange={handleInputChange}
          />
          <input
            style={styles.input}
            type="tel"
            name="phone"
            placeholder="Phone Number"
            value={formData.phone}
            onChange={handleInputChange}
          />
          <button type="submit" style={styles.button}>Join Now</button>
        </form>
      </section>

      <footer style={styles.footer}>
        <p>© 2025 AUTHENTIC DAN Gym. All rights reserved.</p>
      </footer>
    </div>
  );
}

